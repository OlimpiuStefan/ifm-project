@* ═══════════════════════════════════════════════════════════════════
   HOST 2, the Blazor side. PREPARED BY THE TRAINER.
   Participants never open this file. It is here so they can read it
   if they want to, not so they can write it.

   It does exactly three things:
     1. loads their module   →  import('./js/gauge.js')
     2. calls their exports  →  init and update
     3. hands them a way to call back  →  DotNetObjectReference
   It never calls destroy: see DisposeAsync at the bottom for why.
   Built into a runnable app by hosts/second/setup.sh.
   ═══════════════════════════════════════════════════════════════════ *@

@page "/gauge"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IJSRuntime JS
@using System.Text.Json
@using Microsoft.JSInterop

<h3>Gauge, host 2</h3>
<div @ref="_el" class="gauge"><div class="needle"></div></div>
<button @onclick="Bump">Bump</button>
<p><a href="">Home</a></p>

@code {
    private IJSObjectReference? _module;
    private DotNetObjectReference<Gauge>? _self;
    private ElementReference _el;
    private double _value = 0;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Not OnInitializedAsync, during prerendering there is no browser yet.
        if (!firstRender) return;

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>(
                "import", "./js/gauge.js");          // ← their file, unchanged

            // The user may have left the page while the import was in flight.
            // DisposeAsync has already run and found nothing to release.
            if (_disposed)
            {
                await _module.DisposeAsync();
                return;
            }

            _self = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("init", _el, _self);
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone (tab closed, network dropped): nothing to set up.
        }
    }

    private async Task Bump()
    {
        _value = (_value + 17) % 100;
        if (_module is null || _disposed) return;
        try
        {
            await _module.InvokeVoidAsync("update", _el, new { value = _value });
        }
        catch (JSDisconnectedException) { }
    }

    // This is what their `host.invokeMethodAsync('Notify', ...)` reaches.
    [JSInvokable]
    public Task Notify(string kind, JsonElement detail)
    {
        Console.WriteLine($"[host] {kind}: {detail}");
        return Task.CompletedTask;
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        // First, so an OnAfterRenderAsync still awaiting the import sees it.
        _disposed = true;

        // NOTE: we do NOT call back into their module here on purpose.
        // Microsoft's guidance is explicit, the element may already be
        // gone, and on server rendering the circuit may already be down.
        // Their advice: the JS side notices by itself, with a MutationObserver.
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        _self?.Dispose();
    }
}
